"""Open a TL in the existing macOS app and explicitly start playback."""

import argparse
import os
from pathlib import Path
import subprocess
from urllib.parse import urlencode, quote


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("record", type=Path, help="existing .tl file")
    parser.add_argument("--app", type=Path,
                        default=Path(__file__).resolve().parent / "build/IntegerFM.app",
                        help="existing IntegerFM.app (default: apps/macos/build/IntegerFM.app)")
    args = parser.parse_args(argv)
    record = args.record.expanduser().resolve()
    app = args.app.expanduser().resolve()
    if record.suffix.lower() != ".tl" or not record.is_file() or not os.access(record, os.R_OK):
        parser.error("record must be an existing readable .tl file")
    if not (app / "Contents/MacOS/IntegerFM").is_file():
        parser.error("IntegerFM.app is not built; build it first or supply --app PATH")
    url = "fmspike://play?" + urlencode({"path": str(record)}, quote_via=quote)
    try:
        subprocess.run(["/usr/bin/open", "-a", str(app), url], check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"tlplay: could not open JotTune Synth: {error}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
